{
  "permissions": {
    "allow": [
      "Bash(git mv:*)",
      "Skill(frontend-design)",
      "Bash(grep:*)",
      "Bash(for:*)",
      "Bash(do echo \"Checking $f...\")",
      "Bash(node --check:*)",
      "Bash(echo:*)",
      "Bash(done)",
      "Bash(do echo \"=== $class ===\")",
      "Bash(wc:*)",
      "mcp__ide__getDiagnostics",
      "Bash(chmod:*)",
      "Bash(./scripts/generate-version.sh:*)",
      "Bash(./scripts/version.sh:*)",
      "Bash(find:*)",
      "Bash(do echo \"=== $f ===\")",
      "Bash(python3 -m json.tool:*)",
      "Bash(npm init:*)",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(timeout 5 npx vite:*)",
      "Bash(npx vite build:*)",
      "Bash(npm run lint:*)",
      "Bash(npx eslint:*)",
      "WebSearch",
      "Bash(ls:*)",
      "Bash(npm run generate-assets:*)",
      "Bash(npm outdated:*)",
      "Bash(node:*)",
      "Bash(git -C /home/max/Repositories/atomic/godluckwiththat status --short public/audio/)",
      "Bash(python3:*)",
      "Bash(echo === Checking the t\\(\\) function signature ===:*)",
      "Bash(fi)",
      "Bash(head:*)",
      "Bash(echo === CSS unit consistency analysis ===:*)",
      "Bash(echo === CSS Variables count \\(fixed\\) ===:*)",
      "Bash(while read val)",
      "Bash(do echo \"=== Value ''$val'' used by: ===\")",
      "Bash(convert:*)",
      "Bash(sort -k2)",
      "Bash(du:*)",
      "Bash(ffmpeg:*)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/notify.sh 'Claude: Permission request'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint -- --fix 2>&1 && npm run build 2>&1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/notify.sh 'Claude: Ready'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "./scripts/statusline.sh",
    "padding": 0
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Working"
    ]
  }
}
